# Server-only. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://dukan:replace-me@localhost:5432/dukan?schema=public
APP_ORIGIN=http://localhost:3000
ADMIN_PHONE=+919876543210
ADMIN_NAME=Store owner
WHATSAPP_RECIPIENT=+919876543210
# Set true only behind a proxy that replaces x-forwarded-for.
TRUST_PROXY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Approved template with one DOCUMENT header and no body parameters.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Local tests only; ignored in NODE_ENV=production. Never enable on a shared server.
ALLOW_TEST_AUTH=false
TEST_OTP=
