# Phase 2: development only. The local-file adapter refuses NODE_ENV=production.
DEV_DATA_FILE=.data/phase2.json
# Replace the demo identity before using real OTP. Must be a +91 Indian number.
ADMIN_PHONE=+919999999999
ADMIN_OTP_PROVIDER=mock
ALLOW_DEV_OTP=true
WHATSAPP_PROVIDER=mock
# Origin of the store. Leave unset for local development (request origin is used).
# SITE_ORIGIN=https://your-store.example
# Enable only behind a proxy that overwrites the incoming forwarded-for header.
TRUST_PROXY_IP=false

# Live OTP adapter (change ADMIN_OTP_PROVIDER=twilio, ALLOW_DEV_OTP=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Official WhatsApp Cloud API (change WHATSAPP_PROVIDER=cloud)
# API sender identity; this is NOT the admin recipient number.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Set the recipient and its consent through authenticated /admin/settings.
