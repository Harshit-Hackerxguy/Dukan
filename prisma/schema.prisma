generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SUBMITTED
  SENT
  DELIVERED
  FAILED
  UNCERTAIN
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  UNCERTAIN
}

model Admin {
  passwordHash String?
  id           String             @id @default(uuid())
  phone        String             @unique
  name         String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  sessions     AdminSession[]
  adjustments  StockAdjustment[]
  balances     InventoryBalance[]
  auditLogs    AuditLog[]
}

model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model OtpChallenge {
  id        String   @id @default(uuid())
  phone     String
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Category {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String    @default("")
  illustration String    @default("rice")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id          String           @id @default(uuid())
  name        String
  hindiName   String           @default("")
  description String           @default("")
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@index([categoryId, active])
}

model ProductVariant {
  id           String             @id @default(uuid())
  productId    String
  product      Product            @relation(fields: [productId], references: [id])
  sku          String             @unique
  weight       Decimal            @db.Decimal(12, 3)
  unit         String
  pricePaise   Int
  image        String             @default("")
  illustration String             @default("rice")
  tone         String             @default("green")
  badge        String             @default("")
  available    Boolean            @default(true)
  active       Boolean            @default(true)
  version      Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  inventory    InventoryBalance?
  adjustments  StockAdjustment[]
  items        OrderRequestItem[]

  @@index([productId, active])
}

model InventoryBalance {
  variantId   String         @id
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int            @default(0)
  version     Int            @default(0)
  updatedAt   DateTime       @updatedAt
  updatedById String?
  updatedBy   Admin?         @relation(fields: [updatedById], references: [id])
}

model StockAdjustment {
  id               String         @id @default(uuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  previousQuantity Int
  newQuantity      Int
  difference       Int
  adminId          String
  admin            Admin          @relation(fields: [adminId], references: [id])
  reason           String         @default("")
  createdAt        DateTime       @default(now())

  @@index([variantId, createdAt])
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  phone         String         @unique
  phoneVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        OrderRequest[]

  @@index([name])
}

model OrderRequest {
  id              String             @id @default(uuid())
  idempotencyHash String             @unique
  payloadHash     String
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  totalPaise      Int
  status          OrderStatus        @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           OrderRequestItem[]
  memo            CashMemo?

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model OrderRequestItem {
  id             String         @id @default(uuid())
  orderId        String
  order          OrderRequest   @relation(fields: [orderId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  productId      String
  name           String
  hindiName      String
  packaging      String
  quantity       Int
  unitPricePaise Int
  lineTotalPaise Int

  @@unique([orderId, variantId])
}

model CashMemo {
  id             String                    @id @default(uuid())
  number         String                    @unique
  orderId        String                    @unique
  order          OrderRequest              @relation(fields: [orderId], references: [id])
  storageRef     String                    @unique
  pdf            Bytes
  documentStatus String                    @default("READY")
  // Historical API delivery metadata; manual orders leave these empty.
  recipientPhone String?
  deliveryStatus DeliveryStatus?
  createdAt      DateTime                  @default(now())
  attempts       WhatsAppDeliveryAttempt[]
  job            OutboxJob?
}

// Retained only to preserve historical delivery records. No runtime sender uses these models.
model WhatsAppDeliveryAttempt {
  id                String         @id @default(uuid())
  memoId            String
  memo              CashMemo       @relation(fields: [memoId], references: [id])
  recipientPhone    String
  providerMessageId String?        @unique
  status            DeliveryStatus @default(PENDING)
  providerResponse  Json?
  error             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([memoId, createdAt])
}

model OutboxJob {
  id            String    @id @default(uuid())
  memoId        String    @unique
  memo          CashMemo  @relation(fields: [memoId], references: [id])
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

model StoreSettings {
  id                String   @id @default("store")
  name              String   @default("dukan")
  contact           String   @default("")
  location          String   @default("")
  hours             String   @default("")
  // Historical API recipient, no longer configured or used.
  whatsappRecipient String?
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  action    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}

model CustomerSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  name      String
  phone     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
